            .ui-row { display: flex; gap: 10px; margin-bottom: 10px; align-items: flex-end; }
            .ui-col { flex: 1; }
            .ui-label { display: block; font-size: 11px; font-weight: 800; margin-bottom: 4px; color: ${t.subtext} !important; text-transform: uppercase; letter-spacing: 0.5px; }
            .ui-input { width: 100%; padding: 8px; border: 1px solid ${t.inputBorder}; font-size: 13px; background: ${t.inputBg} !important; color: ${t.text} !important; outline: none; border-radius: 4px; }
            .ui-btn { padding: 8px; border: 1px solid ${t.border}; background: ${t.btnBg} !important; color: ${t.text} !important; cursor: pointer; font-size: 11px; font-weight: 600; text-align: center; border-radius: 4px; }
            .ui-btn:hover { background: ${t.btnHover} !important; }
 
            #lang-select { font-size: 12px; border: 1px solid ${t.border}; padding: 3px 6px; border-radius: 4px; background: ${t.inputBg} !important; color: ${t.text} !important; max-width: 120px; }
            #font-select { background: ${t.inputBg} !important; color: ${t.text} !important; }
 
            #save-btn { width: 75%; height: 40px; background: ${config.accentColor} !important; color: #fff !important; border: none; font-weight: bold; cursor: pointer; font-size: 14px; border-radius: 6px; }
            #stop-btn { width: 22%; height: 40px; background: ${config.menuDark ? '#45475a' : '#333'} !important; color: #fff !important; border: none; cursor: pointer; font-size: 16px; border-radius: 6px; }
            #theme-toggle-btn { background: ${t.btnBg} !important; color: ${t.text} !important; border: 1px solid ${t.border}; border-radius: 50%; width: 30px; height: 30px; cursor: pointer; font-size: 14px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; padding: 0; }
            #theme-toggle-btn:hover { background: ${t.btnHover} !important; }
 
            #music-status-text { font-weight: 600; }
            #design-menu-box input[type="range"] { accent-color: ${config.accentColor}; }
        `;
    };
 
    const updateMusicStatus = () => {
        const el = document.getElementById('music-status-text');
        if (!el || !window.audioPl) return;
        const cur = i18n[userLang];
        el.textContent = window.audioPl.paused ? cur.paused : cur.playing;
        el.style.color = window.audioPl.paused ? '#e74c3c' : '#27ae60';
    };
 
    const renderMenuContent = (langCode) => {
        const cur = i18n[langCode];
        const isCustomFont = !!config.customFont;
 
        menu.innerHTML = `
            <div id="menu-header">
                <span style="font-weight:bold; font-size:16px;">${cur.title}</span>
                <div style="display:flex; gap:6px; align-items:center;">
                    <!-- FIX 3: dark/light toggle button -->
                    <button id="theme-toggle-btn" title="Toggle menu theme">${config.menuDark ? '☀️' : '🌙'}</button>
                    <select id="lang-select">
                        ${Object.keys(i18n).map(k => `<option value="${k}" ${langCode===k?'selected':''}>${i18n[k].flag} ${k.toUpperCase()}</option>`).join('')}
                    </select>
                </div>
            </div>
            <div id="menu-scroll-body">
                <label class="ui-label">${cur.font}</label>
                <select id="font-select" class="ui-input" style="margin-bottom:8px;">
                    ${fontList.map(f => `<option value="${f}" ${(!isCustomFont && config.font===f)?'selected':''}>${f}</option>`).join('')}
                    <option value="__custom__" ${isCustomFont?'selected':''}>✏️ ${cur.customFont.split('(')[0].trim()}</option>
                </select>
                <div id="custom-font-wrap" style="display:${isCustomFont ? 'block' : 'none'}; margin-top:6px;">
                <input type="text" id="custom-font-input" class="ui-input" placeholder="${cur.customFontPlaceholder}" value="${config.customFont || ''}">
                <div style="margin-top:4px; font-size:10px; color:#888 !important; line-height: 1.2;">
                  ${cur.findFont} <a href="https://fonts.google.com" target="_blank" style="color: #0077ff !important; text-decoration: underline;">Google Fonts</a>
                </div>
                </div>
 
                <label class="ui-label">${cur.bg}</label>
                <input type="text" id="bg-input" class="ui-input" value="${config.bg.startsWith('data') ? cur.file : config.bg}">
                <div class="ui-row" style="margin-top:6px;">
                    <button id="bg-browse-btn" class="ui-btn ui-col">${cur.browse}</button>
                    <button id="bg-reset-btn" class="ui-btn ui-col" style="color:#e74c3c !important; border-color:#fadbd8 !important;">${cur.resetBg}</button>
                </div>
                <input type="file" id="bg-file" accept="image/*" style="display:none">
 
                <div class="ui-row" style="margin-top:10px;">
                    <div class="ui-col">
                        <label class="ui-label">${cur.bgColor}</label>
                        <input type="color" id="bg-color-picker" value="${config.bgColor}" style="width:100%; height:34px; border:none; cursor:pointer; background:none;">
                    </div>
                    <div class="ui-col" id="gradient-col" style="display:${config.useGradient ? 'block' : 'none'};">
                        <label class="ui-label">${cur.gradient}</label>
                        <input type="color" id="bg-gradient-picker" value="${config.bgGradient}" style="width:100%; height:34px; border:none; cursor:pointer; background:none;">
                    </div>
                </div>
 
                <label style="display:flex; align-items:center; gap:10px; margin: 10px 0; font-size:13px; cursor:pointer; font-weight:600;">
                    <input type="checkbox" id="gradient-toggle" ${config.useGradient ? 'checked' : ''} style="width:16px; height:16px;"> ${cur.useGradient}
                </label>
 
                <div class="ui-row">
                    <div class="ui-col">
                        <label class="ui-label">${cur.opacity}</label>
                        <input type="range" id="opacity-input" min="0" max="1" step="0.05" value="${config.bgOpacity}" style="width:100%;">
                    </div>
                    <div class="ui-col">
                        <label class="ui-label">${cur.radius}</label>
                        <input type="range" id="radius-input" min="0" max="40" value="${config.radius}" style="width:100%;">
                    </div>
                </div>
 
                <div class="ui-row">
                    <div class="ui-col"><label class="ui-label">${cur.text}</label><input type="color" id="color-picker" value="${config.textColor}" style="width:100%; height:34px; border:none; background:none;"></div>
                    <div class="ui-col"><label class="ui-label">${cur.accent}</label><input type="color" id="accent-picker" value="${config.accentColor}" style="width:100%; height:34px; border:none; background:none;"></div>
                </div>
 
                <label class="ui-label">${cur.music}</label>
                <input type="text" id="music-input" class="ui-input" value="${config.music.startsWith('data') ? cur.localMusic : config.music}">
                <button id="music-browse-btn" class="ui-btn" style="width:100%; margin-top:6px;">${cur.browse}</button>
                <input type="file" id="music-file" accept="audio/*" style="display:none">
 
                <label class="ui-label" style="margin-top:12px;">${cur.vol}</label>
                <input type="range" id="volume-input" min="0" max="100" value="${config.volume * 100}" style="width:100%;">
 
                <div style="margin-top:12px; font-size:12px; border-top:1px solid #eee; padding-top:8px;">
                   <strong>${cur.musicStatus}</strong> <span id="music-status-text">—</span>
                </div>
            </div>
            <div id="menu-footer">
                <div class="ui-row" style="margin-bottom:10px;">
                    <button id="export-btn" class="ui-btn ui-col">${cur.exportTheme}</button>
                    <button id="import-btn" class="ui-btn ui-col">${cur.importTheme}</button>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <button id="save-btn">SAVE & APPLY</button>
                    <button id="stop-btn">⏯</button>
                </div>
                <input type="file" id="import-file" accept=".json" style="display:none">
            </div>
        `;
        attachEvents(langCode);
        updateMusicStatus();
    };
 
    const attachEvents = (langCode) => {
        const cur = i18n[langCode];
 
        document.getElementById('lang-select').onchange = (e) => {
            userLang = e.target.value; GM_setValue('lang', userLang); renderMenuContent(userLang);
        };
 
 
        document.getElementById('theme-toggle-btn').onclick = () => {
            config.menuDark = !config.menuDark;
            GM_setValue('menuDark', config.menuDark);
            applyStyles();
            renderMenuContent(userLang);
        };
 
        document.getElementById('gradient-toggle').onchange = (e) => {
            config.useGradient = e.target.checked;
            document.getElementById('gradient-col').style.display = config.useGradient ? 'block' : 'none';
            applyStyles();
        };
 
        document.getElementById('font-select').onchange = (e) => {
            const val = e.target.value;
            document.getElementById('custom-font-wrap').style.display = (val === '__custom__') ? 'block' : 'none';
            if (val !== '__custom__') { config.customFont = ''; config.font = val; applyStyles(); }
        };
 
        document.getElementById('custom-font-input').oninput = (e) => { config.customFont = e.target.value; applyStyles(); };
        document.getElementById('bg-color-picker').oninput = (e) => { config.bgColor = e.target.value; applyStyles(); };
        document.getElementById('bg-gradient-picker').oninput = (e) => { config.bgGradient = e.target.value; applyStyles(); };
        document.getElementById('opacity-input').oninput = (e) => { config.bgOpacity = e.target.value; applyStyles(); };
        document.getElementById('radius-input').oninput = (e) => { config.radius = e.target.value; applyStyles(); };
        document.getElementById('color-picker').oninput = (e) => { config.textColor = e.target.value; applyStyles(); };
        document.getElementById('accent-picker').oninput = (e) => { config.accentColor = e.target.value; applyStyles(); };
 
        document.getElementById('bg-reset-btn').onclick = () => { config.bg = ''; document.getElementById('bg-input').value = ''; applyStyles(); };
 
        document.getElementById('bg-browse-btn').onclick = () => document.getElementById('bg-file').click();
        document.getElementById('bg-file').onchange = (e) => {
            const reader = new FileReader();
            reader.onload = (ev) => { config.bg = ev.target.result; document.getElementById('bg-input').value = cur.file; applyStyles(); };
            reader.readAsDataURL(e.target.files[0]);
        };
 
        document.getElementById('music-browse-btn').onclick = () => document.getElementById('music-file').click();
        document.getElementById('music-file').onchange = (e) => {
            const reader = new FileReader();
            reader.onload = (ev) => { config.music = ev.target.result; document.getElementById('music-input').value = cur.localMusic; };
            reader.readAsDataURL(e.target.files[0]);
        };
 
        document.getElementById('volume-input').oninput = (e) => {
            config.volume = e.target.value / 100;
            if (window.audioPl) window.audioPl.volume = config.volume;
        };
 
        document.getElementById('stop-btn').onclick = () => {
            if (window.audioPl) { window.audioPl.paused ? window.audioPl.play().catch(()=>{}) : window.audioPl.pause(); setTimeout(updateMusicStatus, 100); }
        };
 
        document.getElementById('export-btn').onclick = () => {
            const blob = new Blob([JSON.stringify(config, null, 2)], { type: 'application/json' });
            const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'bliish-theme.json'; a.click();
        };
 
        document.getElementById('import-btn').onclick = () => document.getElementById('import-file').click();
        document.getElementById('import-file').onchange = (e) => {
            const reader = new FileReader();
            reader.onload = (ev) => {
                try {
                    const imported = JSON.parse(ev.target.result);
                    Object.assign(config, imported);
                    GM_setValue('bg', config.bg); GM_setValue('bgColor', config.bgColor); GM_setValue('bgGradient', config.bgGradient);
                    GM_setValue('useGradient', config.useGradient); GM_setValue('textColor', config.textColor); GM_setValue('accentColor', config.accentColor);
                    GM_setValue('bgOpacity', config.bgOpacity); GM_setValue('customRadius', config.radius); GM_setValue('musicVolume', config.volume);
                    GM_setValue('font', config.font); GM_setValue('customFont', config.customFont); GM_setValue('music', config.music);
                    GM_setValue('menuDark', config.menuDark);
                    location.reload();
                } catch(err) { alert('Import error'); }
            };
            reader.readAsText(e.target.files[0]);
        };
 
        document.getElementById('save-btn').onclick = () => {
            const bgVal = document.getElementById('bg-input').value;
            GM_setValue('bg', bgVal.includes('🖼️') ? config.bg : bgVal);
            GM_setValue('bgColor', config.bgColor); GM_setValue('bgGradient', config.bgGradient); GM_setValue('useGradient', config.useGradient);
            GM_setValue('textColor', config.textColor); GM_setValue('accentColor', config.accentColor); GM_setValue('bgOpacity', config.bgOpacity);
            GM_setValue('customRadius', config.radius); GM_setValue('musicVolume', config.volume); GM_setValue('font', config.font); GM_setValue('customFont', config.customFont);
            GM_setValue('menuDark', config.menuDark);
            const musicVal = document.getElementById('music-input').value;
            GM_setValue('music', musicVal.includes('🎵') ? config.music : musicVal);
            location.reload();
        };
    };
 
    const menu = document.createElement('div');
    menu.id = 'design-menu-box';
    document.body.appendChild(menu);
    menu.style.display = 'none';
 
    document.body.appendChild(Object.assign(document.createElement('button'), {
        id: 'toggle-btn', innerHTML: '🎨',
        onclick: () => menu.style.display = menu.style.display === 'none' ? 'flex' : 'none'
    }));
 
    renderMenuContent(userLang);
    applyStyles();
 
    if (config.music) {
        window.audioPl = new Audio(config.music); window.audioPl.loop = true; window.audioPl.volume = config.volume;
        document.addEventListener('click', () => { if (window.audioPl.paused) window.audioPl.play().catch(()=>{}); }, { once: true });
        setInterval(updateMusicStatus, 1000);
    }
})();
