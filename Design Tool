            /* =========================
               PROFILE LAYOUT
            ========================= */

            .lite-wall-header,
            .lite-profile-header,
            .lite-user-header {
                display:flex !important;
                flex-direction:column !important;
                align-items:${avatarAlign} !important;
                justify-content:flex-start !important;
                gap:10px !important;
            }

            /* =========================
               AVATAR
            ========================= */

            .lite-wall-avatar,
            .lite-profile-avatar,
            .lite-user-avatar {
                display:flex !important;
                width:100% !important;
                justify-content:${avatarAlign} !important;
                align-items:${avatarAlign} !important;
                ${glowWrapStyle}
                transition:filter .3s;
            }

            .lite-wall-avatar img,
            .lite-profile-avatar img,
            .lite-user-avatar img {
                ${shapeStyle}
            }

            /* =========================
               DISPLAY NAME
            ========================= */

            .lite-wall-name,
            .lite-profile-name,
            .lite-user-name,
            .lite-display-name,
            .lite-wall-username,
            .lite-username {
                width:100% !important;
                display:block !important;
                text-align:${textAlign} !important;
            }

            /* =========================
               BIO
            ========================= */

            .lite-wall-desc,
            .lite-wall-bio,
            .lite-wall-about,
            .lite-profile-bio,
            .lite-user-bio,
            .lite-bio {
                width:100% !important;
                display:block !important;
                text-align:${textAlign} !important;
            }



            /* Toggle btn */
            #toggle-btn { position:fixed;top:15px;right:15px;z-index:10001;width:48px;height:48px;border:none;cursor:pointer;background:${ac};color:#fff;font-size:22px;border-radius:50%;box-shadow:0 4px 15px rgba(0,0,0,.3);transition:.2s; }
            #toggle-btn:hover { transform:scale(1.08); }

            /* Menu wrapper */
            #design-menu-box { position:fixed;top:60px;right:20px;z-index:10000;width:340px;max-width:calc(100vw - 40px);max-height:calc(100vh - 80px);display:flex;flex-direction:column;box-shadow:0 15px 45px rgba(0,0,0,.4);font-family:'Segoe UI',Tahoma,sans-serif;border-radius:${Math.max(r,6)}px;overflow:hidden;border:1px solid ${t.border};background:${t.bg}; }
            #design-menu-box * { color:${t.text} !important;text-shadow:none !important;box-sizing:border-box; }
            #menu-header { padding:12px 15px;border-bottom:1px solid ${t.border};display:flex;justify-content:space-between;align-items:center;background:${t.surface};flex-shrink:0; }

            /* Tab bar */
            #tab-bar { display:flex;border-bottom:1px solid ${t.border};flex-shrink:0;background:${t.surface};border-radius:0 !important; }
            .tab-btn { flex:1;padding:9px 4px;border:none;border-radius:0 !important;background:transparent !important;color:${t.sub} !important;font-size:11px;font-weight:800;cursor:pointer;border-bottom:2px solid transparent;transition:.15s;letter-spacing:.3px; }
            .tab-btn.active { color:${t.text} !important;border-bottom-color:${ac} !important;background:${t.bg} !important;border-radius:0 !important; }
            .tab-btn:hover:not(.active) { background:${t.btnHover} !important;border-radius:0 !important; }

            #menu-scroll-body { overflow-y:auto;padding:14px;flex-grow:1;scrollbar-width:thin;background:${t.bg}; }
            #menu-footer { padding:12px 14px;border-top:1px solid ${t.border};background:${t.surface};flex-shrink:0; }
            .ui-row { display:flex;gap:8px;margin-bottom:10px;align-items:flex-end; }
            .ui-col { flex:1; }
            .ui-label { display:block;font-size:10px;font-weight:800;margin-bottom:4px;color:${t.sub} !important;text-transform:uppercase;letter-spacing:.6px; }
            .ui-input { width:100%;padding:7px 9px;border:1px solid ${t.inputBorder};font-size:13px;background:${t.inputBg} !important;color:${t.text} !important;outline:none;border-radius:5px; }
            .ui-btn { padding:7px 10px;border:1px solid ${t.border};background:${t.btnBg} !important;color:${t.text} !important;cursor:pointer;font-size:11px;font-weight:700;text-align:center;border-radius:5px; }
            .ui-btn:hover { background:${t.btnHover} !important; }
            .ui-btn-danger { color:#e74c3c !important;border-color:#fcd5d5 !important; }
            #lang-select { font-size:12px;border:1px solid ${t.border};padding:3px 5px;border-radius:4px;background:${t.inputBg} !important;color:${t.text} !important;max-width:110px; }
            #font-select,#symbol-theme-select { background:${t.inputBg} !important;color:${t.text} !important; }
            #save-btn { width:100%;height:38px;background:${ac} !important;color:#fff !important;border:none;font-weight:bold;cursor:pointer;font-size:13px;border-radius:6px; }
            #stop-btn { height:38px;padding:0 14px;background:${config.menuDark?'#45475a':'#444'} !important;color:#fff !important;border:none;cursor:pointer;font-size:16px;border-radius:6px; }
            #theme-toggle-btn { background:${t.btnBg} !important;color:${t.text} !important;border:1px solid ${t.border};border-radius:50%;width:28px;height:28px;cursor:pointer;font-size:13px;flex-shrink:0;padding:0; }
            #theme-toggle-btn:hover { background:${t.btnHover} !important; }
            #design-menu-box input[type=range] { accent-color:${ac}; }

            /* Effects */
            .fx-row { display:flex;align-items:center;gap:8px;margin-bottom:9px;padding:9px 10px;border:1px solid ${t.border};border-radius:7px;background:${t.surface}; }
            .fx-toggle { width:38px;height:21px;border-radius:11px;position:relative;cursor:pointer;border:none;transition:.2s;flex-shrink:0; }
            .fx-toggle.on  { background:${ac} !important; }
            .fx-toggle.off { background:${t.inputBorder} !important; }
            .fx-toggle::after { content:'';position:absolute;top:2.5px;left:2.5px;width:16px;height:16px;border-radius:50%;background:#fff;transition:.2s; }
            .fx-toggle.on::after { left:19.5px; }
            .fx-name { font-size:12px;font-weight:700;flex:1; }
            .fx-controls { display:flex;align-items:center;gap:6px; }
            .fx-color { width:26px;height:26px;border:none;border-radius:4px;cursor:pointer;padding:1px;background:none; }
            .fx-slider { width:56px;cursor:pointer; }

            /* Profile tab */
            .prof-note { font-size:11px;color:#e67e22 !important;background:rgba(230,126,34,.1);padding:7px 9px;border-radius:5px;margin-bottom:12px;line-height:1.4; }
            .chip-row { display:flex;gap:5px;flex-wrap:wrap;margin-bottom:10px; }
            .chip { padding:4px 10px;font-size:11px;font-weight:700;border:1px solid ${t.border};border-radius:20px;cursor:pointer;background:${t.btnBg} !important;color:${t.text} !important;transition:.15s; }
            .chip:hover { background:${t.btnHover} !important; }
            .chip.active { background:${ac} !important;color:#fff !important;border-color:${ac} !important; }
            #music-status-text { font-weight:700; }

            /* Symbol editor */
            .sym-row { display:flex;align-items:center;gap:6px;margin-bottom:7px; }
            .sym-orig { font-size:18px;min-width:28px;text-align:center;flex-shrink:0; }
            .sym-label { font-size:11px;color:${t.sub} !important;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
            .sym-input { width:70px;padding:4px 6px;border:1px solid ${t.inputBorder};border-radius:4px;font-size:16px;background:${t.inputBg} !important;color:${t.text} !important;text-align:center; }
            .sym-theme-chip { padding:3px 9px;font-size:11px;font-weight:700;border:1px solid ${t.border};border-radius:20px;cursor:pointer;background:${t.btnBg} !important;color:${t.text} !important;transition:.15s;white-space:nowrap; }
            .sym-theme-chip.active { background:${ac} !important;color:#fff !important;border-color:${ac} !important; }
            .sym-theme-chip:hover:not(.active) { background:${t.btnHover} !important; }
            #sym-theme-scroller { display:flex;gap:6px;overflow-x:auto;padding-bottom:4px;margin-bottom:10px;scrollbar-width:thin; }
            .sym-divider { border:none;border-top:1px solid ${t.border};margin:10px 0; }
            #sym-save-feedback { font-size:11px;color:#27ae60 !important;font-weight:700;display:none;margin-top:4px; }

            /* Profile section divider */
            .prof-divider { border:none;border-top:1px solid ${t.border};margin:12px 0 10px; }
        `;
    };

    const updateMusicStatus = () => {
        const el = $('music-status-text');
        if (!el || !window.audioPl) return;
        const cur = i18n[userLang];
        el.textContent = window.audioPl.paused ? cur.paused : cur.playing;
        el.style.color  = window.audioPl.paused ? '#e74c3c' : '#27ae60';
    };

    // ─── EFFECTS ENGINE ─────────────────────────────────────────────────────────
    let fxCanvas, fxCtx;
    const P = { rain:[], dust:[], glitter:[], fireflies:[] };

    const initParticles = () => {
        const W = window.innerWidth, H = window.innerHeight;
        P.rain      = Array.from({length:130}, () => ({ x:Math.random()*W, y:Math.random()*H, speed:7+Math.random()*8, len:14+Math.random()*20 }));
        P.dust      = Array.from({length:80},  () => ({ x:Math.random()*W, y:Math.random()*H, vx:(Math.random()-.5)*.5, vy:-Math.random()*.4-.1, size:1+Math.random()*2.5, life:Math.random() }));
        P.glitter   = Array.from({length:70},  () => ({ x:Math.random()*W, y:Math.random()*H, size:1+Math.random()*3.5, phase:Math.random()*Math.PI*2 }));
        P.fireflies = Array.from({length:35},  () => ({ x:Math.random()*W, y:Math.random()*H, vx:(Math.random()-.5)*1.2, vy:(Math.random()-.5)*1.2, glow:Math.random(), glowDir:Math.random()<.5?1:-1, size:2+Math.random()*3 }));
    };

    const setupCanvas = () => {
        fxCanvas = document.createElement('canvas');
        fxCanvas.id = 'fx-canvas';
        fxCanvas.style.cssText = 'position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:9997;';
        fxCanvas.width = window.innerWidth; fxCanvas.height = window.innerHeight;
        document.body.appendChild(fxCanvas);
        fxCtx = fxCanvas.getContext('2d');
        window.addEventListener('resize', () => {
            fxCanvas.width = window.innerWidth; fxCanvas.height = window.innerHeight;
            initParticles();
        });
        initParticles();
    };

    const fxLoop = () => {
        const W = fxCanvas.width, H = fxCanvas.height;
        fxCtx.clearRect(0,0,W,H);
        const fx = config.effects;

        if (fx.rain.on) {
            const spd = fx.rain.speed * 2.2;
            const rgb = hexToRgb(fx.rain.color);
            fxCtx.strokeStyle = `rgba(${rgb},.65)`;
            fxCtx.lineWidth = 1;
            P.rain.forEach(p => {
                p.y += p.speed * spd;
                if (p.y > H + p.len) { p.y = -p.len; p.x = Math.random()*W; }
                fxCtx.beginPath(); fxCtx.moveTo(p.x, p.y); fxCtx.lineTo(p.x - 1.5, p.y + p.len); fxCtx.stroke();
            });
        }

        if (fx.dust.on) {
            const rgb = hexToRgb(fx.dust.color);
            P.dust.forEach(p => {
                p.x += p.vx; p.y += p.vy; p.life += .0025;
                if (p.y < -10 || p.x < -10 || p.x > W+10) { p.x = Math.random()*W; p.y = H+5; p.life = 0; }
                const a = Math.min(1, Math.sin(p.life * Math.PI) * fx.dust.intensity * .8);
                if (a <= 0) return;
                fxCtx.fillStyle = `rgba(${rgb},${a})`;
                fxCtx.beginPath(); fxCtx.arc(p.x, p.y, p.size, 0, Math.PI*2); fxCtx.fill();
            });
        }

        if (fx.glitter.on) {
            const rgb = hexToRgb(fx.glitter.color);
            P.glitter.forEach(p => {
                p.phase += .055;
                const a = (Math.sin(p.phase)*.5+.5) * fx.glitter.intensity;
                if (a < .04 && Math.random() < .02) { p.x = Math.random()*W; p.y = Math.random()*H; }
                const s = p.size * (.5 + Math.sin(p.phase)*.5);
                fxCtx.save();
                fxCtx.globalAlpha = a;
                fxCtx.shadowColor = `rgba(${rgb},${a})`; fxCtx.shadowBlur = 8;
                fxCtx.fillStyle = `rgba(${rgb},1)`;
                fxCtx.strokeStyle = `rgba(${rgb},1)`; fxCtx.lineWidth = 1;
                [0, Math.PI/2, Math.PI, Math.PI*1.5].forEach(ang => {
                    fxCtx.beginPath(); fxCtx.moveTo(p.x, p.y); fxCtx.lineTo(p.x + Math.cos(ang+p.phase*.15)*s*3.5, p.y + Math.sin(ang+p.phase*.15)*s*3.5); fxCtx.stroke();
                });
                fxCtx.beginPath(); fxCtx.arc(p.x, p.y, s*.7, 0, Math.PI*2); fxCtx.fill();
                fxCtx.restore();
            });
        }

        if (fx.fireflies.on) {
            const spd = fx.fireflies.speed;
            const rgb = hexToRgb(fx.fireflies.color);
            P.fireflies.forEach(p => {
                p.x += p.vx * spd; p.y += p.vy * spd;
                p.glow += p.glowDir * .018;
                if (p.glow >= 1 || p.glow <= 0) p.glowDir *= -1;
                if (p.x < 0 || p.x > W) p.vx *= -1;
                if (p.y < 0 || p.y > H) p.vy *= -1;
                p.vx += (Math.random()-.5)*.04; p.vy += (Math.random()-.5)*.04;
                p.vx = Math.max(-1.8, Math.min(1.8, p.vx)); p.vy = Math.max(-1.8, Math.min(1.8, p.vy));
                const a = .35 + p.glow * .65;
                fxCtx.save();
                fxCtx.shadowColor = `rgba(${rgb},${a})`; fxCtx.shadowBlur = 14 * p.glow;
                fxCtx.fillStyle = `rgba(${rgb},${a})`;
                fxCtx.beginPath(); fxCtx.arc(p.x, p.y, p.size*(.4+p.glow*.6), 0, Math.PI*2); fxCtx.fill();
                fxCtx.restore();
            });
        }

        window._bliishFxId = requestAnimationFrame(fxLoop);
    };

    const setupBlood = () => {
        let el = $('blood-overlay');
        if (!el) {
            el = document.createElement('div');
            el.id = 'blood-overlay';
            el.style.cssText = 'position:fixed;top:0;left:0;width:100%;pointer-events:none;z-index:9996;';
            document.body.appendChild(el);
        }
        if (!config.effects.blood.on) { el.style.display = 'none'; return; }
        el.style.display = 'block';
        const c = config.effects.blood.color;
        const count = 14;
        const drips = Array.from({length:count}, (_,i) => {
            const x = (i / (count-1) * 96 + 2 + (Math.random()-.5)*3).toFixed(1);
            const h = (35 + Math.random()*90).toFixed(1);
            const w = (6 + Math.random()*10).toFixed(1);
            const op = (.65 + Math.random()*.35).toFixed(2);
            return `<ellipse cx="${x}%" cy="0" rx="${w/2}%" ry="${w/3}%" fill="${c}" opacity="${op}"/>` +
                   `<path d="M${(+x-(+w/2)/2).toFixed(1)}% 0 Q${x}% ${+h*.3}% ${x}% ${h}% Q${(+x+(+w/2)/2).toFixed(1)}% ${+h*.5}% ${(+x+0.3).toFixed(1)}% 0" fill="${c}" opacity="${op}"/>`;
        }).join('');
        el.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 200" preserveAspectRatio="none" style="width:100%;height:180px;display:block;">${drips}</svg>`;
    };

    const applyEffects = () => {
        const needCanvas = ['rain','dust','glitter','fireflies'].some(k => config.effects[k].on);
        if (needCanvas) {
            if (!fxCanvas) setupCanvas();
            if (!window._bliishFxId) fxLoop();
        } else if (window._bliishFxId) {
            cancelAnimationFrame(window._bliishFxId);
            window._bliishFxId = null;
            if (fxCanvas) { fxCtx.clearRect(0,0,fxCanvas.width,fxCanvas.height); }
        }
        setupBlood();
    };

    // ─── PROFILE APPLICATION ─────────────────────────────────────────────────────
    const applyProfile = () => {
        applySymbolTheme();
        interceptLikes();
    };

    const interceptLikes = () => {
        const likedPosts = getObj('likedPosts', {});
        document.querySelectorAll('.lite-post-foot a, .lite-foot-item a').forEach(link => {
            if (link.dataset.liInt || !link.href.includes('like')) return;
            link.dataset.liInt = '1';
            const postId = link.href.match(/\/(?:post|wall|p)s?\/([^/]+)\/like/i)?.[1] ||
                           link.href.match(/[?&](?:post|p)=([^&]+)/)?.[1];
            if (!postId) return;
            if (likedPosts[postId]) { link.style.fontWeight = '900'; link.style.opacity = '1'; }
            link.addEventListener('click', e => {
                e.preventDefault();
                likedPosts[postId] = !likedPosts[postId];
                setObj('likedPosts', likedPosts);
                link.style.fontWeight = likedPosts[postId] ? '900' : '';
                GM_xmlhttpRequest({ method:'GET', url:link.href, headers:{ 'Referer':window.location.href }, onload:()=>{} });
            });
        });
    };

    // ─── TAB STATE ──────────────────────────────────────────────────────────────
    let currentTab = 'design';
    let symShowAll = false;

    // ─── RENDER ─────────────────────────────────────────────────────────────────
    const renderDesignTab = (cur, isCustomFont, bgDisp) => `
        <label class="ui-label">${cur.font}</label>
        <select id="font-select" class="ui-input" style="margin-bottom:8px;">
            ${fontList.map(f=>`<option value="${f}" ${(!isCustomFont&&config.font===f)?'selected':''}>${f}</option>`).join('')}
            <option value="__custom__" ${isCustomFont?'selected':''}>✏️ ${cur.customFont.split('(')[0].trim()}</option>
        </select>
        <div id="custom-font-wrap" style="display:${isCustomFont?'block':'none'};margin-bottom:10px;">
            <input type="text" id="custom-font-input" class="ui-input" placeholder="${cur.customFontPlaceholder}" value="${config.customFont||''}">
            <div style="margin-top:4px;font-size:10px;color:#888 !important;">${cur.findFont} <a href="https://fonts.google.com" target="_blank" style="color:#0077ff !important;text-decoration:underline;">Google Fonts</a></div>
        </div>

        <label class="ui-label">${cur.bg}</label>
        <input type="text" id="bg-input" class="ui-input" value="${bgDisp}" style="margin-bottom:6px;">
        <div class="ui-row">
            <button id="bg-browse-btn" class="ui-btn ui-col">${cur.browse}</button>
            <button id="bg-reset-btn" class="ui-btn ui-col ui-btn-danger">${cur.resetBg}</button>
        </div>
        <input type="file" id="bg-file" accept="image/*" style="display:none">
        <div class="ui-row" style="margin-top:10px;">
            <div class="ui-col">
                <label class="ui-label">${cur.bgColor}</label>
                <input type="color" id="bg-color-picker" value="${config.bgColor}" style="width:100%;height:34px;border:none;cursor:pointer;background:none;">
            </div>
            <div class="ui-col" id="gradient-col" style="display:${config.useGradient?'block':'none'};">
                <label class="ui-label">${cur.gradient}</label>
                <input type="color" id="bg-gradient-picker" value="${config.bgGradient}" style="width:100%;height:34px;border:none;cursor:pointer;background:none;">
            </div>
        </div>
        <label style="display:flex;align-items:center;gap:8px;margin:10px 0;font-size:13px;cursor:pointer;font-weight:700;">
            <input type="checkbox" id="gradient-toggle" ${config.useGradient?'checked':''} style="width:16px;height:16px;"> ${cur.useGradient}
        </label>
        <div class="ui-row">
            <div class="ui-col"><label class="ui-label">${cur.opacity}</label><input type="range" id="opacity-input" min="0" max="1" step="0.05" value="${config.bgOpacity}" style="width:100%;"></div>
            <div class="ui-col"><label class="ui-label">${cur.radius}</label><input type="range" id="radius-input" min="0" max="40" value="${config.radius}" style="width:100%;"></div>
        </div>
        <div class="ui-row">
            <div class="ui-col"><label class="ui-label">${cur.text}</label><input type="color" id="color-picker" value="${config.textColor}" style="width:100%;height:34px;border:none;background:none;"></div>
            <div class="ui-col"><label class="ui-label">${cur.accent}</label><input type="color" id="accent-picker" value="${config.accentColor}" style="width:100%;height:34px;border:none;background:none;"></div>
        </div>
        <label class="ui-label">${cur.music}</label>
        <input type="text" id="music-input" class="ui-input" value="${config.music&&config.music.startsWith('data')?cur.localMusic:config.music}" style="margin-bottom:6px;">
        <div class="ui-row">
            <button id="music-browse-btn" class="ui-btn ui-col">${cur.browse}</button>
            <button id="music-remove-btn" class="ui-btn ui-col ui-btn-danger">${cur.removeMusic}</button>
        </div>
        <input type="file" id="music-file" accept="audio/*" style="display:none">
        <label class="ui-label" style="margin-top:10px;">${cur.vol}</label>
        <input type="range" id="volume-input" min="0" max="100" value="${config.volume*100}" style="width:100%;margin-bottom:10px;">
        <div style="font-size:12px;border-top:1px solid rgba(128,128,128,.2);padding-top:8px;">
            <strong>${cur.musicStatus}</strong> <span id="music-status-text">—</span>
        </div>`;

    const renderEffectsTab = (cur) => {
        const defs = [
            { key:'blood',     label:cur.fxBlood,     slider:'speed',     max:3 },
            { key:'glitter',   label:cur.fxGlitter,   slider:'intensity', max:1 },
            { key:'rain',      label:cur.fxRain,       slider:'speed',     max:3 },
            { key:'dust',      label:cur.fxDust,       slider:'intensity', max:1 },
            { key:'fireflies', label:cur.fxFireflies, slider:'speed',     max:2 },
        ];
        return `<p style="font-size:11px;color:#888 !important;margin:0 0 12px;">Toggle effects, pick colors, adjust intensity/speed.</p>` +
            defs.map(({key,label,slider,max}) => {
                const e = config.effects[key];
                return `<div class="fx-row">
                    <button class="fx-toggle ${e.on?'on':'off'}" data-fx="${key}" title="Toggle"></button>
                    <span class="fx-name">${label}</span>
                    <div class="fx-controls">
                        <input type="color" class="fx-color" data-fx="${key}" value="${e.color}" title="${cur.fxColor}">
                        <input type="range" class="fx-slider" data-fx="${key}" data-slider="${slider}" min="0" max="${max}" step="0.1" value="${e[slider]??0.5}" title="${slider==='intensity'?cur.fxIntensity:cur.fxSpeed}">
                    </div>
                </div>`;
            }).join('');
    };

    const renderSymbolTab = (cur) => {
        const allThemes = [
            ...Object.entries(SYMBOL_THEMES).map(([k, v]) => ({
                id: k,
                label: v.labels?.[userLang] || v.labels?.en || k
            })),
            ...customSymThemes.map(t => ({
                id: t.id,
                label: '✏️ ' + t.name
            })),
            {
                id: '__custom__',
                label: cur.symCustomLabel
            },
        ];

        const visibleSymbols = symShowAll ? ORIGINAL_SYMBOLS : ORIGINAL_SYMBOLS.slice(0, 5);
        const editorMap = config.symbolTheme === '__custom__'
            ? (config.customSymMap || {})
            : (getActiveSymbolMap() || {});

        return `
        <label class="ui-label">${cur.symbolTheme}</label>
        <div id="sym-theme-scroller">
            ${allThemes.map(t => `
                <button class="sym-theme-chip ${config.symbolTheme === t.id ? 'active' : ''}" data-symtheme="${t.id}">
                    ${t.label}
                </button>
            `).join('')}
        </div>
        <hr class="sym-divider">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
            <span style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.6px;color:inherit;">${cur.symCustomLabel}</span>
            <label style="display:flex;align-items:center;gap:5px;font-size:11px;cursor:pointer;font-weight:700;">
                <input type="checkbox" id="sym-show-all" ${symShowAll ? 'checked' : ''} style="width:13px;height:13px;">
                ${cur.symShowAll}
            </label>
        </div>
        <div id="sym-rows">
            ${visibleSymbols.map(sym => `
                <div class="sym-row">
                    <span class="sym-orig">${sym.original}</span>
                    <span class="sym-label">${sym.labels?.[userLang] || sym.labels?.en || sym.original}</span>
                    <input type="text" class="sym-input" data-symkey="${sym.original}" placeholder="${sym.original}" value="${editorMap[sym.original] || ''}" maxlength="8">
                </div>
            `).join('')}
        </div>
        <div style="font-size:10px;margin:6px 0 10px;">
            ${cur.symHint}
            <a href="https://emojidb.org/" target="_blank" style="color:#0077ff !important;text-decoration:underline;">emojidb.org</a>
        </div>
        <hr class="sym-divider">
        <label class="ui-label">${cur.symCustomName}</label>
        <div style="display:flex;gap:6px;align-items:center;margin-bottom:4px;">
            <input type="text" id="sym-custom-name" class="ui-input" placeholder="${cur.symCustomNamePh}" style="flex:1;" value="${(() => { const found = customSymThemes.find(t => t.id === config.symbolTheme); return found ? found.name : ''; })()}">
            <button id="sym-save-btn" class="ui-btn" style="font-weight:800;white-space:nowrap;">${cur.symCustomSave}</button>
        </div>
        <div id="sym-save-feedback">${cur.symCustomSaved}</div>
    `;
    };

    const renderProfileTab = (cur) => {
        const prof = config.profile;
        const frames = ['none','round','square','roundedSq','heart','sun','cat'];
        const fLabels = [cur.profFrameNone, cur.profFrameRound, cur.profFrameSquare, cur.profFrameRoundedSq, cur.profFrameHeart, cur.profFrameSun, cur.profFrameCat];
        const positions = ['left','center','right'];
        const pLabels = [cur.profPosLeft, cur.profPosCenter, cur.profPosRight];

        return `
            <div class="prof-note">${cur.profNote}</div>

            <!-- Frame shape -->
            <label class="ui-label">${cur.profFrame}</label>
            <div class="chip-row">
                ${frames.map((f,i)=>`<button class="chip ${prof.frame===f?'active':''}" data-frame="${f}">${fLabels[i]}</button>`).join('')}
            </div>

            <!-- Glow -->
            <label class="ui-label">${cur.profGlow}</label>
            <div class="chip-row" style="margin-bottom:6px;">
                <button class="chip ${!prof.glow?'active':''}" data-glow="false">${cur.profGlowNone}</button>
                <button class="chip ${prof.glow?'active':''}" data-glow="true">${cur.profGlowOn}</button>
            </div>

            <hr class="prof-divider">

            <!-- Avatar position -->
            <label class="ui-label">${cur.profAvatarPos}</label>
            <div class="chip-row">
                ${positions.map((p,i)=>`<button class="chip ${prof.pos===p?'active':''}" data-pos="${p}">${pLabels[i]}</button>`).join('')}
            </div>


        `;
    };

    const renderMenuContent = (langCode) => {
        const cur = i18n[langCode];
        const isCustomFont = !!config.customFont;
        const bgDisp = config.bgOriginalUrl || (config.bg&&config.bg.startsWith('data') ? cur.file : config.bg) || '';
        const ac = config.accentColor;

        menu.innerHTML = `
            <div id="menu-header">
                <span style="font-weight:900;font-size:15px;letter-spacing:.3px;">${cur.title} ✦</span>
                <div style="display:flex;gap:6px;align-items:center;">
                    <button id="theme-toggle-btn">${config.menuDark?'☀︎':'⏾'}</button>
                    <select id="lang-select">
                        ${Object.keys(i18n).map(k=>`<option value="${k}" ${langCode===k?'selected':''}>${i18n[k].flag} ${k.toUpperCase()}</option>`).join('')}
                    </select>
                </div>
            </div>
            <div id="tab-bar">
                <button class="tab-btn ${currentTab==='design'?'active':''}" data-tab="design">${cur.tabDesign}</button>
                <button class="tab-btn ${currentTab==='effects'?'active':''}" data-tab="effects">${cur.tabEffects}</button>
                <button class="tab-btn ${currentTab==='symbols'?'active':''}" data-tab="symbols">🔣 ${userLang==='uk'?'Символи':'Symbols'}</button>
                <button class="tab-btn ${currentTab==='profile'?'active':''}" data-tab="profile">${cur.tabProfile}</button>
            </div>
            <div id="menu-scroll-body">
                ${currentTab==='design'  ? renderDesignTab(cur, isCustomFont, bgDisp) : ''}
                ${currentTab==='effects' ? renderEffectsTab(cur) : ''}
                ${currentTab==='symbols' ? renderSymbolTab(cur) : ''}
                ${currentTab==='profile' ? renderProfileTab(cur) : ''}
            </div>
            ${currentTab === 'design' ? `
            <div id="menu-footer">
                <div class="ui-row" style="margin-bottom:8px;">
                    <button id="export-btn" class="ui-btn ui-col">${cur.exportTheme}</button>
                    <button id="import-btn" class="ui-btn ui-col">${cur.importTheme}</button>
                </div>
                <div style="display:flex;gap:6px;">
                    <button id="save-btn" style="flex:1;">SAVE & APPLY</button>
                    <button id="stop-btn">⏯</button>
                </div>
                <input type="file" id="import-file" accept=".json" style="display:none">
            </div>
            ` : ''}`;

        attachEvents(langCode);
        updateMusicStatus();
    };

    // ─── EVENTS ─────────────────────────────────────────────────────────────────
    const attachEvents = (langCode) => {
        const cur = i18n[langCode];

        menu.querySelectorAll('.tab-btn').forEach(btn => {
            btn.onclick = () => { currentTab = btn.dataset.tab; renderMenuContent(langCode); };
        });

        $('lang-select')?.addEventListener('change', e => { userLang = e.target.value; GM_setValue('lang', userLang); renderMenuContent(userLang); });
        $('theme-toggle-btn')?.addEventListener('click', () => { config.menuDark = !config.menuDark; applyStyles(); renderMenuContent(langCode); });

        // ── Design tab ──────────────────────────────────────
        if (currentTab === 'design') {
            [['bg-color-picker','bgColor'],['bg-gradient-picker','bgGradient'],['opacity-input','bgOpacity'],
             ['radius-input','radius'],['color-picker','textColor'],['accent-picker','accentColor'],
             ['custom-font-input','customFont']].forEach(([id,key]) => {
                $(id)?.addEventListener('input', e => { config[key] = e.target.value; applyStyles(); });
            });
            $('gradient-toggle')?.addEventListener('change', e => {
                config.useGradient = e.target.checked;
                $('gradient-col').style.display = e.target.checked ? 'block' : 'none';
                applyStyles();
            });
            $('font-select')?.addEventListener('change', e => {
                const val = e.target.value;
                $('custom-font-wrap').style.display = val === '__custom__' ? 'block' : 'none';
                if (val !== '__custom__') { config.customFont = ''; config.font = val; applyStyles(); }
            });
            $('bg-input')?.addEventListener('input', e => {
                const url = e.target.value.trim();
                if (!url) { config.bg = ''; config.bgOriginalUrl = ''; applyStyles(); return; }
                config.bgOriginalUrl = url;
                fetchImageAsBase64(url, b64 => { config.bg = b64; applyStyles(); }, () => { config.bg = url; applyStyles(); });
            });
            $('bg-reset-btn')?.addEventListener('click', () => { config.bg = ''; config.bgOriginalUrl = ''; $('bg-input').value = ''; applyStyles(); });
            $('bg-browse-btn')?.addEventListener('click', () => $('bg-file').click());
            $('bg-file')?.addEventListener('change', e => {
                const fr = new FileReader();
                fr.onload = ev => { config.bg = ev.target.result; config.bgOriginalUrl = ''; $('bg-input').value = cur.file; applyStyles(); };
                fr.readAsDataURL(e.target.files[0]);
            });
            $('music-browse-btn')?.addEventListener('click', () => $('music-file').click());
            $('music-file')?.addEventListener('change', e => {
                const fr = new FileReader();
                fr.onload = ev => {
                    config.music = ev.target.result;
                    $('music-input').value = cur.localMusic;
                    if (window.audioPl) { window.audioPl.src = ev.target.result; window.audioPl.play().catch(()=>{}); }
                    else { window.audioPl = Object.assign(new Audio(ev.target.result), { loop:true, volume:config.volume }); window.audioPl.play().catch(()=>{}); }
                    updateMusicStatus();
                };
                fr.readAsDataURL(e.target.files[0]);
            });
            $('music-remove-btn')?.addEventListener('click', () => {
                config.music = '';
                if (window.audioPl) { window.audioPl.pause(); window.audioPl.src = ''; window.audioPl = null; }
                $('music-input').value = '';
                updateMusicStatus();
            });
            $('volume-input')?.addEventListener('input', e => {
                config.volume = e.target.value / 100;
                if (window.audioPl) window.audioPl.volume = config.volume;
            });
            $('stop-btn')?.addEventListener('click', () => {
                if (!window.audioPl) return;
                window.audioPl.paused ? window.audioPl.play().catch(()=>{}) : window.audioPl.pause();
                setTimeout(updateMusicStatus, 100);
            });
            $('export-btn')?.addEventListener('click', () => {
                const exportData = { ...config };
                delete exportData.profile;
                const a = document.createElement('a');
                a.href = URL.createObjectURL(new Blob([JSON.stringify(exportData, null, 2)], { type:'application/json' }));
                a.download = 'bliish-theme.json'; a.click();
            });
            $('import-btn')?.addEventListener('click', () => $('import-file').click());
            $('import-file')?.addEventListener('change', e => {
                const fr = new FileReader();
                fr.onload = ev => { try { Object.assign(config, JSON.parse(ev.target.result)); saveConfig(); location.reload(); } catch { alert('Import error'); } };
                fr.readAsText(e.target.files[0]);
            });
            $('save-btn')?.addEventListener('click', () => {
                const mv = $('music-input').value;
                if (!mv.includes('🎵')) config.music = mv;
                saveConfig(); location.reload();
            });
        }

        // ── Effects tab ─────────────────────────────────────
        if (currentTab === 'effects') {
            menu.querySelectorAll('.fx-toggle').forEach(btn => {
                btn.addEventListener('click', () => {
                    const key = btn.dataset.fx;
                    config.effects[key].on = !config.effects[key].on;
                    btn.className = `fx-toggle ${config.effects[key].on ? 'on' : 'off'}`;
                    setObj('effects', config.effects);
                    applyEffects();
                });
            });
            menu.querySelectorAll('.fx-color').forEach(inp => {
                inp.addEventListener('input', e => {
                    config.effects[e.target.dataset.fx].color = e.target.value;
                    setObj('effects', config.effects); applyEffects();
                });
            });
            menu.querySelectorAll('.fx-slider').forEach(inp => {
                inp.addEventListener('input', e => {
                    config.effects[e.target.dataset.fx][e.target.dataset.slider] = Number(e.target.value);
                    setObj('effects', config.effects); applyEffects();
                });
            });
        }

        // ── Symbols tab ──────────────────────────────────────
        if (currentTab === 'symbols') {
            menu.querySelectorAll('.sym-theme-chip').forEach(btn => {
                btn.addEventListener('click', () => {
                    const id = btn.dataset.symtheme;
                    config.symbolTheme = id;
                    GM_setValue('symbolTheme', id);
                    if (id !== '__custom__') {
                        const found = customSymThemes.find(t => t.id === id);
                        const map = found ? found.map : ((SYMBOL_THEMES[id] || SYMBOL_THEMES.none).map);
                        config.customSymMap = { ...map };
                        setObj('customSymMap', config.customSymMap);
                    }
                    applySymbolTheme();
                    renderMenuContent(langCode);
                });
            });

            $('sym-show-all')?.addEventListener('change', e => {
                symShowAll = e.target.checked;
                renderMenuContent(langCode);
            });

            menu.querySelectorAll('.sym-input').forEach(inp => {
                inp.addEventListener('input', e => {
                    const orig = e.target.dataset.symkey;
                    const val = e.target.value.trim();
                    if (!config.customSymMap) config.customSymMap = {};
                    if (val) { config.customSymMap[orig] = val; } else { delete config.customSymMap[orig]; }
                    config.symbolTheme = '__custom__';
                    GM_setValue('symbolTheme', '__custom__');
                    setObj('customSymMap', config.customSymMap);
                    applySymbolTheme();
                    menu.querySelectorAll('.sym-theme-chip').forEach(c => {
                        c.classList.toggle('active', c.dataset.symtheme === '__custom__');
                    });
                });
            });

            $('sym-save-btn')?.addEventListener('click', () => {
                const nameInput = $('sym-custom-name');
                const name = nameInput?.value.trim() || ('Custom ' + (customSymThemes.length + 1));
                const existingIdx = customSymThemes.findIndex(t => t.name === name);
                const id = existingIdx >= 0 ? customSymThemes[existingIdx].id : ('cst_' + Date.now());
                const entry = { id, name, map: { ...config.customSymMap } };
                if (existingIdx >= 0) { customSymThemes[existingIdx] = entry; } else { customSymThemes.push(entry); }
                config.symbolTheme = id;
                GM_setValue('symbolTheme', id);
                setObj('customSymThemes', customSymThemes);
                setObj('customSymMap', config.customSymMap);
                const fb = $('sym-save-feedback');
                if (fb) { fb.style.display = 'block'; setTimeout(() => { fb.style.display = 'none'; }, 2000); }
                applySymbolTheme();
                setTimeout(() => renderMenuContent(langCode), 500);
            });
        }

        // ── Profile tab ──────────────────────────────────────
        if (currentTab === 'profile') {
            const saveProf = () => {
                setObj('profile', config.profile);
                applyStyles();
            };

            menu.querySelectorAll('.chip[data-frame]').forEach(btn => {
                btn.addEventListener('click', () => {
                    config.profile.frame = btn.dataset.frame;
                    menu.querySelectorAll('.chip[data-frame]').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    saveProf();
                });
            });

            menu.querySelectorAll('.chip[data-glow]').forEach(btn => {
                btn.addEventListener('click', () => {
                    config.profile.glow = btn.dataset.glow === 'true';
                    menu.querySelectorAll('.chip[data-glow]').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    saveProf();
                });
            });

            menu.querySelectorAll('.chip[data-pos]').forEach(btn => {
                btn.addEventListener('click', () => {
                    config.profile.pos = btn.dataset.pos;
                    menu.querySelectorAll('.chip[data-pos]').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    saveProf();
                });
            });


        }
    };

    // ─── INIT ────────────────────────────────────────────────────────────────────
    const menu = Object.assign(document.createElement('div'), { id:'design-menu-box' });
    menu.style.display = 'none';
    document.body.appendChild(menu);

    document.body.appendChild(Object.assign(document.createElement('button'), {
        id:'toggle-btn', innerHTML:'👩🏻‍🎨',
        onclick: () => menu.style.display = menu.style.display === 'none' ? 'flex' : 'none',
    }));

    injectSvgClips();
    renderMenuContent(userLang);
    applyStyles();
    applyEffects();

    requestAnimationFrame(() => {
        applyProfile();
        applySymbolTheme();
    });

    if (config.music) {
        window.audioPl = Object.assign(new Audio(config.music), { loop:true, volume:config.volume });
        document.addEventListener('click', () => { if (window.audioPl?.paused) window.audioPl.play().catch(()=>{}); }, { once:true });
        setInterval(updateMusicStatus, 1000);
    }

})();
